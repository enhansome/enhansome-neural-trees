    {
      "description": "In this survey, we present a thorough taxonomy for NTs that expresses the gradual integration and co-evolution of NNs and DTs.",
      "items": [
        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "node_type": "group",
                      "title": "Generalized eclectic techniques",
